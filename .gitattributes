# Padroniza as quebras de linha para todo mundo do time,
# independente do git configurado na maquina de cada um.
# Evita PRs falsos com "arquivo inteiro alterado".

# Por padrao: git detecta arquivos de texto e guarda sempre com LF.
* text=auto eol=lf

# Arquivos binarios: nunca converter.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.db    binary
*.sqlite3 binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
