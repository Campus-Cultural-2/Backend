# Copie este arquivo para .env e ajuste os valores.
# O .env NUNCA vai para o git (está no .gitignore).

# development | production
ENVIRONMENT=development

# Banco de dados.
# Local (SQLite, arquivo na sua máquina):
DATABASE_URL=sqlite:///./database/app.db
# Produção (Postgres). Exemplo:
# DATABASE_URL=postgresql+asyncpg://usuario:senha@host/banco

# Segredo que assina os tokens JWT.
# Gere um novo com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Em produção a aplicação NÃO sobe se este valor não for trocado.
JWT_SECRET_KEY=dev-only-insecure-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cria o admin padrão (admin@example.com / admin123) no startup.
# Precisa ser false em produção.
SEED_DEFAULT_ADMIN=true

# Origens liberadas no CORS, separadas por vírgula.
# Em produção não pode ser "*". Exemplo:
# CORS_ORIGINS=https://meu-app.vercel.app,http://localhost:8081
CORS_ORIGINS=*

# Cloudinary, onde ficam as imagens (banner dos eventos e foto de perfil).
# Pegue os valores no painel do Cloudinary, em Settings > API Keys.
# Sem eles a API funciona, mas o upload de imagens responde 503.
# Em produção a aplicação NÃO sobe sem estes valores.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo, que envia o e-mail com o codigo de recuperacao de senha.
# E por API HTTP, e nao SMTP: o plano gratuito do Render bloqueia as portas
# 25, 465 e 587, entao SMTP funcionaria local e falharia em producao.
# A chave fica no painel do Brevo, em SMTP & API > API Keys. O remetente
# precisa estar verificado no Brevo, em Senders & IP > Senders.
# Sem elas, em desenvolvimento o codigo nao e enviado e aparece um aviso no log.
BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=Campus Cultural UTFPR

# Dominios de e-mail aceitos no cadastro, separados por virgula. A comparacao
# e pelo dominio exato: "alunos.utfpr.edu.br" nao conta como "utfpr.edu.br".
# Os valores abaixo ja sao o padrao; so mude se souber o que esta fazendo.
# Vazio desliga a restricao (usado pela suite e2e). Em producao nao pode ficar
# vazio.
ALLOWED_EMAIL_DOMAINS=utfpr.edu.br,alunos.utfpr.edu.br
# Professor so com e-mail de servidor. Junto com a verificacao de e-mail, e o
# que impede um aluno de se cadastrar como professor.
PROFESSOR_EMAIL_DOMAINS=utfpr.edu.br
