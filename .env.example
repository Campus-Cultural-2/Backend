# Copie este arquivo para .env e ajuste os valores.
# O .env NUNCA vai para o git (está no .gitignore).

# development | production
ENVIRONMENT=development

# Banco de dados.
# Local (SQLite, arquivo na sua máquina):
DATABASE_URL=sqlite:///./database/app.db
# Produção (Postgres). Exemplo:
# DATABASE_URL=postgresql+asyncpg://usuario:senha@host/banco

# Segredo que assina os tokens JWT.
# Gere um novo com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Em produção a aplicação NÃO sobe se este valor não for trocado.
JWT_SECRET_KEY=dev-only-insecure-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cria o admin padrão (admin@example.com / admin123) no startup.
# Precisa ser false em produção.
SEED_DEFAULT_ADMIN=true

# Origens liberadas no CORS, separadas por vírgula.
# Em produção não pode ser "*". Exemplo:
# CORS_ORIGINS=https://meu-app.vercel.app,http://localhost:8081
CORS_ORIGINS=*
